# Default model provider: gemini | anthropic | ollama
MODEL_PROVIDER=gemini

# Google Gemini (supports tool calling)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=

# Local Ollama
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# AWS Open Data (Anonymous S3 read)
AWS_NO_SIGN_REQUEST=YES
